---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { waLink } from '../lib/whatsapp';

import heroImg from '../assets/images/hero-socios-julio-e-mirian.webp';
import julioImg from '../assets/images/autoridade-dr-julio-cesar.webp';
import mirianImg from '../assets/images/autoridade-dra-mirian-assuncao.webp';
import fachadaImg from '../assets/images/fachada-clinica-assuncao-padua.webp';
import recepcaoImg from '../assets/images/recepcao-clinica-monograma-ap.webp';
import equipeImg from '../assets/images/equipe-socios-jaleco-preto.webp';
import logoPretoImg from '../assets/images/logo-ap-preto.webp';

const pageTitle = 'Assunção e Pádua Odontologia em Passos-MG | Dentistas';
const pageDescription =
  'Clínica odontológica no Centro de Passos-MG. Reabilitação oral, ortodontia e odontopediatria com Dr. Júlio César e Dra. Mirian Assunção. Agende no WhatsApp.';

// Hero: dimensões generosas e preload da mesma variante WebP otimizada usada no <Image>
const HERO_W = 560;
const HERO_H = Math.round((HERO_W * heroImg.height) / heroImg.width);
const heroOptimized = await getImage({ src: heroImg, width: HERO_W, height: HERO_H, format: 'webp', quality: 90 });

const wa = {
  hero: 'Olá! Gostaria de agendar uma consulta na Assunção e Pádua Odontologia.',
  final: 'Olá! Gostaria de consultar os horários disponíveis para atendimento na clínica Assunção e Pádua.',
};

const dores = [
  {
    num: '01',
    title: 'Dificuldade para mastigar e insegurança ao sorrir',
    text: 'Adiar a reposição ou o tratamento de dentes desgastados prejudica a digestão, compromete a articulação e reduz a confiança no dia a dia. Você merece uma reabilitação precisa e funcional.',
  },
  {
    num: '02',
    title: 'Troca constante de dentistas em franquias',
    text: 'Iniciar um procedimento e ser atendido por um profissional diferente a cada visita quebra a continuidade do cuidado. Na Assunção e Pádua, você é acompanhado do início ao fim pelo mesmo especialista.',
  },
  {
    num: '03',
    title: 'Ansiedade e receio de procedimentos invasivos',
    text: 'Tanto adultos quanto crianças precisam de um ambiente sereno e de profissionais que expliquem cada etapa com clareza técnica, eliminando o estresse da consulta odontológica.',
  },
];

const servicos = [
  {
    title: 'Reabilitação Oral e Próteses',
    resumo:
      'Restabelecimento anatômico e funcional da mastigação através de próteses fixas, próteses sobre implantes e restaurações estéticas de alta precisão.',
    publico: 'Adultos com perdas parciais ou totais de dentes e desgastes dentários severos.',
    responsavel: 'Dr. Júlio César de Pádua (RT CRO-MG 62726)',
    cta: 'Agendar Reabilitação Oral',
    dataCta: 'servico-reabilitacao',
    msg: 'Olá, Dr. Júlio! Gostaria de informações sobre Reabilitação Oral na clínica.',
  },
  {
    title: 'Ortodontia e Alinhamento Facial',
    resumo:
      'Correção do posicionamento dentário e equilíbrio das bases ósseas com aparelhos fixos e alinhadores modernos para estética e função duradouras.',
    publico: 'Jovens e adultos que buscam correção oclusal, alinhamento do sorriso e conforto mastigatório.',
    responsavel: 'Dra. Mirian Assunção (CRO-MG 62766)',
    cta: 'Agendar Avaliação Ortodôntica',
    dataCta: 'servico-ortodontia',
    msg: 'Olá, Dra. Mirian! Gostaria de agendar uma avaliação ortodôntica na clínica.',
  },
  {
    title: 'Odontopediatria e Prevenção Infantil',
    resumo:
      'Acompanhamento integral do desenvolvimento bucal desde os primeiros anos de vida, com abordagem acolhedora e foco em prevenção.',
    publico: 'Bebês, crianças e adolescentes em fase de crescimento e dentição mista.',
    responsavel: 'Dra. Mirian Assunção (CRO-MG 62766)',
    cta: 'Agendar Consulta Infantil',
    dataCta: 'servico-odontopediatria',
    msg: 'Olá! Gostaria de agendar uma consulta de odontopediatria para meu filho(a).',
  },
  {
    title: 'Implantodontia e Cirurgia Oral',
    resumo:
      'Planejamento cirúrgico criterioso para instalação de implantes dentários, recuperando a firmeza mastigatória com estabilidade biológica.',
    publico: 'Pacientes com ausência de um ou mais dentes que buscam fixação definitiva e segurança.',
    responsavel: 'Dr. Júlio César de Pádua (RT CRO-MG 62726)',
    cta: 'Agendar Avaliação de Implante',
    dataCta: 'servico-implantes',
    msg: 'Olá, Dr. Júlio! Gostaria de uma avaliação para implantes dentários.',
  },
];

const passos = [
  {
    num: '01',
    title: 'Contato Inicial Direto',
    text: 'Você clica no botão do WhatsApp e nossa equipe organiza o melhor horário para o seu atendimento em Passos.',
  },
  {
    num: '02',
    title: 'Avaliação Clínica e Diagnóstico',
    text: 'Na primeira consulta, o especialista responsável realiza exame detalhado da sua saúde bucal, ouvindo suas queixas e necessidades.',
  },
  {
    num: '03',
    title: 'Planejamento Personalizado',
    text: 'Apresentamos o plano de tratamento com clareza: opções viáveis, tempo estimado e todas as etapas explicadas sem termos inacessíveis.',
  },
  {
    num: '04',
    title: 'Execução e Acompanhamento Contínuo',
    text: 'Seu tratamento é realizado com pontualidade e seguido de consultas de revisão para assegurar longevidade e saúde aos resultados.',
  },
];

const faq = [
  {
    q: 'Onde fica localizada a clínica Assunção e Pádua em Passos-MG?',
    a: 'Estamos localizados no Centro de Passos, na Rua Dr. Manoel Patti, 55. O consultório conta com acessibilidade e ambiente climatizado para receber toda a família.',
    ld: 'Estamos localizados no Centro de Passos, na Rua Dr. Manoel Patti, 55, com estrutura acessível e climatizada para atender toda a família.',
  },
  {
    q: 'Como funciona o agendamento de consultas na clínica?',
    a: 'Os atendimentos são realizados com horário previamente reservado para garantir atenção individualizada. O agendamento é feito diretamente pelo nosso WhatsApp oficial: (35) 98801-1788.',
    ld: 'Os atendimentos são realizados com horário previamente agendado pelo WhatsApp oficial (35) 98801-1788 para assegurar pontualidade e atenção personalizada.',
  },
  {
    q: 'Quais especialidades odontológicas são atendidas no local?',
    a: 'Atendemos Reabilitação Oral, Implantes Dentários, Próteses, Ortodontia para crianças e adultos, e Odontopediatria, sob responsabilidade direta do Dr. Júlio César e da Dra. Mirian.',
    ld: 'Atendemos Reabilitação Oral, Próteses, Implantes Dentários, Ortodontia e Odontopediatria com os especialistas fundadores.',
  },
  {
    q: 'A clínica atende crianças de todas as idades?',
    a: 'Sim. A Dra. Mirian Assunção atua com odontopediatria preventiva e curativa desde a primeira infância, com consultório e abordagem adaptados para o conforto dos pequenos.',
    ld: 'Sim. A Dra. Mirian Assunção realiza acompanhamento odontopediátrico preventivo e curativo desde a primeira infância.',
  },
];

const DOMINIO = 'https://assuncaoepadua.com.br';
const schemaData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Dentist',
      '@id': `${DOMINIO}/#clinic`,
      name: 'Assunção e Pádua Odontologia',
      image: `${DOMINIO}/fachada-assuncao-padua.jpg`,
      telephone: '+55-35-98801-1788',
      url: DOMINIO,
      sameAs: ['https://www.instagram.com/assuncaoepadua/'],
      hasMap: 'https://www.google.com/maps/dir/?api=1&destination=Rua+Dr.+Manoel+Patti,+55,+Passos+-+MG,+37900-053',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Rua Dr. Manoel Patti, 55',
        addressLocality: 'Passos',
        addressRegion: 'MG',
        postalCode: '37900-053',
        addressCountry: 'BR',
      },
      geo: { '@type': 'GeoCoordinates', latitude: -20.7188, longitude: -46.6095 },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:00',
          closes: '18:00',
        },
      ],
      employee: [
        {
          '@type': 'Person',
          name: 'Dr. Júlio César de Pádua',
          jobTitle: 'Cirurgião-Dentista, Reabilitação Oral',
          identifier: 'CRO-MG 62726',
        },
        {
          '@type': 'Person',
          name: 'Dra. Mirian Assunção',
          jobTitle: 'Cirurgiã-Dentista, Ortodontista e Odontopediatra',
          identifier: 'CRO-MG 62766',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${DOMINIO}/#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.ld },
      })),
    },
  ],
});

const btnPrimary =
  'inline-flex items-center justify-center min-h-[50px] min-w-[44px] rounded-xl bg-brand-green px-7 py-3.5 text-base font-semibold text-white hover:bg-brand-green-hover active:scale-[0.975] focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-green shadow-sm';
const btnGhost =
  'inline-flex items-center justify-center min-h-[50px] min-w-[44px] rounded-xl border border-line bg-surface px-7 py-3.5 text-base font-semibold text-grafite-900 hover:border-grafite-900/40 hover:bg-offwhite active:scale-[0.975] focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-green';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={DOMINIO}
  schema={schemaData}
  ogTitle="Assunção e Pádua Odontologia em Passos-MG"
  ogDescription="Reabilitação oral, ortodontia e odontopediatria com atendimento dos especialistas proprietários no Centro de Passos."
  preloadImage={{ src: heroOptimized.src }}
>
  <!-- HEADER -->
  <header class="border-b border-line bg-surface/90 backdrop-blur-md sticky top-0 z-40">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4.5 sm:px-8">
      <a href="#" class="flex items-center gap-3 text-grafite-900 group" aria-label="Assunção e Pádua Odontologia - Início">
        <Image
          src={logoPretoImg}
          alt="Logo Assunção e Pádua Odontologia"
          class="h-9 w-auto object-contain shrink-0"
          loading="eager"
        />
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-1.5">
          <span class="text-lg sm:text-xl font-semibold tracking-tight leading-tight">
            Assunção <span class="text-brand-green font-normal">e</span> Pádua
          </span>
          <span class="text-xs sm:text-base font-normal text-grafite-600 leading-tight">
            Odontologia
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Anchors -->
      <nav class="hidden lg:flex items-center gap-8 text-sm font-medium text-grafite-600" aria-label="Navegação principal">
        <a href="#especialidades" class="hover:text-brand-green transition-colors">Especialidades</a>
        <a href="#estrutura" class="hover:text-brand-green transition-colors">Estrutura</a>
        <a href="#profissionais" class="hover:text-brand-green transition-colors">Profissionais</a>
        <a href="#localizacao" class="hover:text-brand-green transition-colors">Localização</a>
        <a href="#duvidas" class="hover:text-brand-green transition-colors">Dúvidas</a>
      </nav>

      <a
        href={waLink(wa.hero)}
        target="_blank"
        rel="noopener noreferrer"
        data-cta="hero-whatsapp"
        class="hidden md:inline-flex min-h-[44px] items-center rounded-xl bg-brand-green px-6 text-sm font-semibold text-white hover:bg-brand-green-hover active:scale-[0.975] focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-green shadow-sm"
      >
        Agendar Consulta
      </a>
    </div>
  </header>

  <main>
    <!-- 1. HERO -->
    <section class="bg-offwhite border-b border-line">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 sm:px-8 md:py-24 lg:grid-cols-[1.12fr_0.88fr] lg:gap-16">
        <div>
          <h1 class="text-3xl font-semibold tracking-[-0.025em] text-grafite-900 sm:text-4xl lg:text-[46px] leading-[1.18]">
            Cuidado odontológico completo e integrado para você e sua família no Centro de Passos.
          </h1>
          <h2 class="mt-6 max-w-[58ch] text-lg sm:text-[19px] font-normal text-grafite-600 leading-relaxed">
            Da prevenção infantil e ortodontia à reabilitação oral e implantes com planejamento minucioso, acompanhado diretamente pelos responsáveis técnicos.
          </h2>

          <div class="mt-10 flex flex-col gap-3.5 sm:flex-row">
            <a
              href={waLink(wa.hero)}
              target="_blank"
              rel="noopener noreferrer"
              data-cta="hero-whatsapp"
              class={btnPrimary}
            >
              Agendar consulta no WhatsApp
            </a>
            <a href="#especialidades" class={btnGhost}>Conhecer especialidades</a>
          </div>

          <ul class="mt-12 space-y-3.5 border-t border-line pt-8 text-base text-grafite-600">
            <li class="flex items-center gap-3">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-green/10 text-brand-green font-bold text-xs" aria-hidden="true">✓</span>
              Atendimento com os especialistas fundadores
            </li>
            <li class="flex items-center gap-3">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-green/10 text-brand-green font-bold text-xs" aria-hidden="true">✓</span>
              Instalações modernas na Rua Dr. Manoel Patti, Centro
            </li>
            <li class="flex items-center gap-3">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-green/10 text-brand-green font-bold text-xs" aria-hidden="true">✓</span>
              Planejamento individualizado e sem rotatividade clínica
            </li>
          </ul>
        </div>

        <!-- HERO PORTRAIT (Editorial Master Framing) -->
        <figure class="mx-auto w-full max-w-[500px]">
          <div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-sm">
            <Image
              src={heroImg}
              width={HERO_W}
              height={HERO_H}
              format="webp"
              quality={90}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              sizes="(min-width: 1024px) 500px, 92vw"
              alt="Dr. Júlio César de Pádua e Dra. Mirian Assunção, sócios-fundadores da clínica, sorrindo lado a lado"
              class="h-auto w-full object-cover"
            />
          </div>
          <figcaption class="pt-3.5 flex items-center justify-between text-xs font-semibold tracking-wider uppercase text-grafite-600">
            <span class="text-grafite-900">Dr. Júlio César de Pádua</span>
            <span class="text-brand-green">·</span>
            <span class="text-grafite-900">Dra. Mirian Assunção</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- 2. DORES (Architectural Editorial Cadence - No Generic Cards) -->
    <section class="border-b border-line bg-surface">
      <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:py-28">
        <div class="max-w-3xl">
          <h2 class="text-3xl font-semibold tracking-tight text-grafite-900 sm:text-4xl leading-tight">
            A experiência odontológica que sua saúde realmente merece
          </h2>
          <p class="mt-4 text-lg text-grafite-600 leading-relaxed max-w-[62ch]">
            Tratamentos conduzidos com transparência clínica, conforto e previsibilidade.
          </p>
        </div>

        <div class="mt-16 grid gap-10 md:grid-cols-3 md:gap-0 border-y border-line md:divide-x md:divide-line">
          {
            dores.map((d) => (
              <article class="flex flex-col justify-between py-10 md:py-12 md:px-8 first:md:pl-0 last:md:pr-0">
                <div>
                  <span class="text-xs font-semibold tracking-widest text-brand-green uppercase" aria-hidden="true">
                    {d.num}
                  </span>
                  <h3 class="mt-3 text-xl sm:text-[22px] font-semibold leading-snug text-grafite-900">
                    {d.title}
                  </h3>
                  <p class="mt-4 text-base text-grafite-600 leading-relaxed">
                    {d.text}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 3. SERVIÇOS (Architectural Discipline Catalogue - Flat Minimalist) -->
    <section id="especialidades" class="bg-offwhite border-b border-line">
      <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:py-28">
        <div class="max-w-3xl">
          <h2 class="text-3xl font-semibold tracking-tight text-grafite-900 sm:text-4xl leading-tight">
            Áreas de Atuação e Especialidades
          </h2>
          <p class="mt-4 text-lg text-grafite-600 leading-relaxed">
            Diagnóstico e condutas clínicas integradas em Passos-MG.
          </p>
        </div>

        <div class="mt-16 grid gap-x-12 gap-y-14 md:grid-cols-2">
          {
            servicos.map((s) => (
              <article class="flex flex-col justify-between border-t-2 border-line pt-8">
                <div>
                  <h3 class="text-2xl font-semibold text-grafite-900 tracking-tight">{s.title}</h3>
                  <p class="mt-3 text-base text-grafite-600 leading-relaxed">{s.resumo}</p>

                  <dl class="mt-6 space-y-3 text-sm">
                    <div>
                      <dt class="text-xs uppercase font-semibold tracking-wider text-grafite-900/60">Para quem é</dt>
                      <dd class="mt-1 text-grafite-600 leading-relaxed">{s.publico}</dd>
                    </div>
                    <div>
                      <dt class="text-xs uppercase font-semibold tracking-wider text-grafite-900/60">Responsável Técnico</dt>
                      <dd class="mt-1 text-grafite-900 font-semibold">{s.responsavel}</dd>
                    </div>
                  </dl>
                </div>

                <div class="mt-8 pt-6 border-t border-line/60">
                  <a
                    href={waLink(s.msg)}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-cta={s.dataCta}
                    class="inline-flex items-center gap-2 text-sm font-semibold text-brand-green hover:underline group"
                  >
                    <span>{s.cta}</span>
                    <span class="text-brand-green font-bold group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 4. COMO FUNCIONA E ESTRUTURA -->
    <section id="estrutura" class="border-b border-line bg-surface">
      <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:py-28">
        <!-- Progressão das etapas de atendimento -->
        <div class="max-w-3xl">
          <h2 class="text-3xl font-semibold tracking-tight text-grafite-900 sm:text-4xl leading-tight">
            Como é o seu atendimento conosco
          </h2>
        </div>

        <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {
            passos.map((p) => (
              <li class="border-t-2 border-line pt-6">
                <span class="text-xs font-semibold tracking-widest text-brand-green uppercase">
                  Passo {p.num}
                </span>
                <h3 class="mt-2 text-xl font-semibold leading-snug text-grafite-900">{p.title}</h3>
                <p class="mt-3 text-base text-grafite-600 leading-relaxed">{p.text}</p>
              </li>
            ))
          }
        </ol>

        <!-- ESTRUTURA DA CLÍNICA: VITRINE ARQUITETÔNICA COM AS DUAS IMAGENS -->
        <div class="mt-24 border-t border-line pt-16">
          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12">
            <div>
              <h3 class="text-2xl sm:text-3xl font-semibold tracking-tight text-grafite-900">
                Estrutura planejada no Centro de Passos
              </h3>
            </div>
            <p class="text-base sm:text-lg text-grafite-600 max-w-xl leading-relaxed">
              Fachada moderna na Rua Dr. Manoel Patti, 55, com jardim vertical, acessibilidade completa e recepção acolhedora com conforto térmico e acústico.
            </p>
          </div>

          <div class="grid gap-8 md:grid-cols-2 items-start">
            <!-- Imagem 1: Fachada -->
            <figure class="group">
              <div class="overflow-hidden rounded-2xl aspect-[4/3] w-full bg-slate-100 border border-line shadow-sm">
                <Image
                  src={fachadaImg}
                  width={750}
                  height={560}
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                  sizes="(min-width: 1024px) 600px, (min-width: 768px) 50vw, 92vw"
                  alt="Fachada cinza-grafite da clínica Assunção e Pádua, com jardim vertical e placa com o monograma AP, na Rua Dr. Manoel Patti"
                  class="h-full w-full object-cover object-center group-hover:scale-[1.02] transition-transform duration-500"
                />
              </div>
              <figcaption class="mt-3.5 px-1 flex items-center justify-between text-sm">
                <span class="font-semibold text-grafite-900">Fachada Arquitetônica</span>
                <span class="text-grafite-600">Rua Dr. Manoel Patti, 55</span>
              </figcaption>
            </figure>

            <!-- Imagem 2: Recepção -->
            <figure class="group">
              <div class="overflow-hidden rounded-2xl aspect-[4/3] w-full bg-slate-100 border border-line shadow-sm">
                <Image
                  src={recepcaoImg}
                  width={750}
                  height={560}
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                  sizes="(min-width: 1024px) 600px, (min-width: 768px) 50vw, 92vw"
                  alt="Recepção da clínica com balcão em madeira natural freijó, monograma AP e poltrona em veludo azul"
                  class="h-full w-full object-cover object-center group-hover:scale-[1.02] transition-transform duration-500"
                />
              </div>
              <figcaption class="mt-3.5 px-1 flex items-center justify-between text-sm">
                <span class="font-semibold text-grafite-900">Recepção & Acolhimento</span>
                <span class="text-grafite-600">Conforto térmico e acústico</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. AUTORIDADE (Grand Clinical Leadership & Authentic Testimonies - Minimalist) -->
    <section id="profissionais" class="bg-offwhite border-b border-line">
      <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:py-28">
        <div class="max-w-3xl">
